# app setting
SALT_ROUND=10
LOCAL=LOCAL
JWT_SECRET=xxx
JWT_EXPIRATION=900s
APP_PORT=8080
# Domain a SIWE signature must have been signed for, e.g. app.example.com.
# Leave unset only if you do not expose SIWE login: without it a signature
# produced on another site is accepted.
APP_DOMAIN=
NODE_ENV=development
APP_NAME=name

#db settings
DB_TYPE=mongodb

# Connection pool configuration
MIN_POOL_SIZE=1
MAX_POOL_SIZE=10

#mongo
MONGO_URI=xxx
MONGO_DB_NAME=xxx

# postgresql settings
POSTGRES_HOST=xxx
POSTGRES_PORT=5432
POSTGRES_USER=xxx
POSTGRES_PASSWORD=xxx@123
POSTGRES_DB_NAME=nestjs-base

# caching settings
CACHE_DRIVER=memory        # memory | redis | valkey | memcached
CACHE_TTL=60               # default entry lifetime, in SECONDS
CACHE_KEY_PREFIX=          # prepended to every key; set it on a shared cache server
CACHE_MAX_ENTRIES=10000    # memory driver only: cap before LRU eviction

# redis driver
REDIS_URL=xxx

# valkey driver (valkey:// and valkeys:// are accepted)
VALKEY_URL=xxx

# memcached driver
MEMCACHED_SERVERS=localhost:11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=

# mail settings
MAIL_DRIVER=log            # log | ses | sendgrid
# Default sender. Required for ses/sendgrid; both reject an unverified sender.
MAIL_FROM=no-reply@example.com

# amazon ses driver
SES_REGION=ap-southeast-1
SES_ACCESS_KEY_ID=xxx
SES_SECRET_ACCESS_KEY=xxx

# sendgrid driver
SENDGRID_API_KEY=xxx

# storage settings
STORAGE_DRIVER=s3          # s3 | r2

# aws s3
S3_BUCKET=xxx
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
# How putLargeObject chops the body — NOT a threshold; nothing picks between
# putObject and putLargeObject by size. Unset takes 5 MB parts, 4 at a time.
# Part size is floored at 5 MB — S3 rejects anything smaller but the last part.
# Memory used per large upload is roughly PART_SIZE_MB x UPLOAD_CONCURRENCY.
S3_PART_SIZE_MB=
S3_UPLOAD_CONCURRENCY=

# cloudflare r2
R2_BUCKET=xxx
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_PART_SIZE_MB=
R2_UPLOAD_CONCURRENCY=
