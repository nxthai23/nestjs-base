# app setting
SALT_ROUND=10
LOCAL=LOCAL
JWT_SECRET=xxx
JWT_EXPIRATION=900s
APP_PORT=8080
NODE_ENV=development
APP_NAME=name

#db settings
DB_TYPE=mongodb

# Connection pool configuration
MIN_POOL_SIZE=1
MAX_POOL_SIZE=10

#mongo
MONGO_URI=xxx
MONGO_DB_NAME=xxx

# postgresql settings
POSTGRES_HOST=xxx
POSTGRES_PORT=5432
POSTGRES_USER=xxx
POSTGRES_PASSWORD=xxx@123
POSTGRES_DB_NAME=nestjs-base

# redis settings
REDIS_URL=xxx
REDIS_TTL=3600
REDIS_TYPE=single

# storage settings
STORAGE_DRIVER=s3          # s3 | r2

# aws s3
S3_BUCKET=xxx
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
S3_PUBLIC_BASE_URL=

# cloudflare r2
R2_BUCKET=xxx
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_PUBLIC_BASE_URL=
